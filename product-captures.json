{
  "version": 1,
  "project": {
    "id": "quartz-tabsdown",
    "title": "Tabsdown",
    "subtitle": "for Quartz",
    "background": "#f1f7f4",
    "accent": "#668d75",
    "backgroundStyle": "solid",
    "ink": "#173b35",
    "artDirection": "studio",
    "layout": "column",
    "imageZoom": 1,
    "darkBackground": "#18283e",
    "studioTint": "#466e9b",
    "imageOffsetX": 0,
    "studioShade": "#243d66",
    "studioGlow": "#abc9ec"
  },
  "outputDir": "docs/assets/product-captures",
  "captures": [
    {
      "id": "overview-light",
      "provider": "web",
      "url": "/",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "colorScheme": "light",
      "fallback": "docs/assets/product-captures/captures/overview-light.png",
      "ready": {
        "selector": ".tabsdown .tabsdown__tab"
      },
      "localStorage": {
        "theme": "light"
      }
    },
    {
      "id": "overview-dark",
      "provider": "web",
      "url": "/",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "colorScheme": "dark",
      "fallback": "docs/assets/product-captures/captures/overview-dark.png",
      "ready": {
        "selector": ".tabsdown .tabsdown__tab"
      },
      "localStorage": {
        "theme": "dark"
      }
    }
  ],
  "outputs": [
    {
      "id": "hero",
      "template": "showcase",
      "captures": ["overview-light"],
      "width": 1600,
      "height": 900,
      "layout": "column",
      "theme": "light",
      "capturesByTheme": {
        "light": ["overview-light"],
        "dark": ["overview-dark"]
      }
    },
    {
      "id": "hero-dark",
      "template": "showcase",
      "captures": ["overview-dark"],
      "width": 1600,
      "height": 900,
      "layout": "column",
      "theme": "dark",
      "capturesByTheme": {
        "light": ["overview-light"],
        "dark": ["overview-dark"]
      }
    },
    {
      "id": "themes",
      "template": "showcase",
      "captures": ["overview-light"],
      "width": 1600,
      "height": 1000,
      "layout": "column",
      "theme": "light",
      "capturesByTheme": {
        "light": ["overview-light"],
        "dark": ["overview-dark"]
      }
    },
    {
      "id": "themes-dark",
      "template": "showcase",
      "captures": ["overview-dark"],
      "width": 1600,
      "height": 1000,
      "layout": "column",
      "theme": "dark",
      "capturesByTheme": {
        "light": ["overview-light"],
        "dark": ["overview-dark"]
      }
    },
    {
      "id": "social",
      "template": "showcase",
      "captures": ["overview-light"],
      "width": 1200,
      "height": 630,
      "layout": "horizontal",
      "theme": "light",
      "capturesByTheme": {
        "light": ["overview-light"],
        "dark": ["overview-dark"]
      }
    },
    {
      "id": "social-dark",
      "template": "showcase",
      "captures": ["overview-dark"],
      "width": 1200,
      "height": 630,
      "layout": "horizontal",
      "theme": "dark",
      "capturesByTheme": {
        "light": ["overview-light"],
        "dark": ["overview-dark"]
      }
    },
    {
      "id": "horizontal",
      "template": "showcase",
      "layout": "horizontal",
      "captures": ["overview-light"],
      "width": 1600,
      "height": 900,
      "frameHeight": 0.6153086419753087,
      "theme": "light",
      "capturesByTheme": {
        "light": ["overview-light"],
        "dark": ["overview-dark"]
      }
    },
    {
      "id": "horizontal-dark",
      "template": "showcase",
      "layout": "horizontal",
      "captures": ["overview-dark"],
      "width": 1600,
      "height": 900,
      "frameHeight": 0.6153086419753087,
      "theme": "dark",
      "capturesByTheme": {
        "light": ["overview-light"],
        "dark": ["overview-dark"]
      }
    }
  ],
  "prepare": {
    "command": "npm ci --cache .product-captures-cache/npm && node scripts/prepare-product-captures.mjs",
    "timeoutMs": 600000
  },
  "server": {
    "command": "node .github/actions/product-captures/serve.mjs --dir .product-captures-cache/quartz/public --port 4182",
    "url": "http://127.0.0.1:4182",
    "timeoutMs": 60000
  }
}
